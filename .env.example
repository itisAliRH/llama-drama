# Copy to .env (git-ignored) on your laptop and fill in. Placeholders only, never commit real values.

# ElevenLabs: scripts/gen_voice.py reads it from the environment or this .env.
ELEVENLABS_API_KEY=

# Live voice on the board. The board app (python/main.py) does NOT read .env:
# it takes ELEVENLABS_API_KEY from its environment or data/elevenlabs.key, and
# LIVE_TTS=1 from its environment or data/live_tts. Both are needed to enable it.
LIVE_TTS=0

# Edge Impulse: scripts/ei_upload.sh and scripts/ei_deploy.sh source this .env.
EI_API_KEY=
EI_PROJECT_ID=

# Board SSH target for scripts/deploy.sh, pull_data.sh, push_assets.sh, rollback_board.sh.
# They read it from the shell environment (export it); ei_deploy.sh passes it on from .env.
# Keep the quotes: ei_*.sh source this file as shell.
BOARD_HOST='arduino@<board-ip>'
